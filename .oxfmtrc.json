{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "useTabs": false,
  "tabWidth": 2,
  "printWidth": 100,
  "singleQuote": false,
  "jsxSingleQuote": false,
  "quoteProps": "as-needed",
  "trailingComma": "all",
  "semi": true,
  "arrowParens": "always",
  "bracketSameLine": false,
  "bracketSpacing": true,
  "ignorePatterns": [
    "*.lock",
    "**/*.gen.ts",
    "**/*.generated.ts",
    "**/*.gen.tsx",
    "docs/omp/CONTROL-SURFACE.md",
    "docs/omp/PARITY.md",
    "packages/app/src/terminal/webview/terminal-emulator-webview-html.ts"
  ]
}
